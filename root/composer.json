{
  "name": "appsbyv/v-chatgpt-social-status-feeds",
  "description": "Manage, schedule, and distribute social media status feeds.",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.2",
    "phpmailer/phpmailer": "^6.8",
    "doctrine/dbal": "^4.3",
    "nikic/fast-route": "2.0.0-beta1",
    "openai-php/client": "*",
    "respect/validation": "^2.4",
    "nyholm/psr7": "^1.8",
    "guzzlehttp/guzzle": "^7.9",
    "psr/log": "^3.0",
    "psr/http-message": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
