{
  "name": "appsbyv/v-chatgpt-social-status-feeds",
  "description": "A modular PHP application for managing, scheduling, and distributing social media status updates.",
  "type": "project",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
    "phpunit/phpunit": "^11.5.58",
    "phpstan/phpstan": "^2.3.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "root/app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "phpcs": "phpcs --standard=phpcs.xml --extensions=php root/",
    "phpcbf": "phpcbf --standard=phpcs.xml --extensions=php root/",
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "phpunit"
  }
}
